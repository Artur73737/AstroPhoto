# Compile every public project header in its own translation unit. This catches
# accidental reliance on include order and source-file adjacency after refactors.
if(BUILD_TESTING AND ASTRO_BUILD_APP)
 file(GLOB_RECURSE project_headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/src/*.hpp")
 set(header_units)
 set(header_roots)
 foreach(header IN LISTS project_headers)
  if(NOT header MATCHES "/include/(.+)$")
   message(FATAL_ERROR "Project header outside a feature include directory: ${header}")
  endif()
  set(public_name "${CMAKE_MATCH_1}")
  string(REGEX REPLACE "/include/.*$" "/include" include_root "${header}")
  list(APPEND header_roots "${include_root}")
  string(SHA256 header_id "${public_name}")
  set(unit "${CMAKE_CURRENT_BINARY_DIR}/header_checks/${header_id}.cpp")
  file(GENERATE OUTPUT "${unit}" CONTENT "#include <${public_name}>\n")
  list(APPEND header_units "${unit}")
 endforeach()
 list(REMOVE_DUPLICATES header_roots)
 add_library(astro_header_checks OBJECT ${header_units})
 target_include_directories(astro_header_checks PRIVATE ${header_roots} "${PROJECT_SOURCE_DIR}/external/json/include" "${CMAKE_CURRENT_BINARY_DIR}/generated")
 target_link_libraries(astro_header_checks PRIVATE imgui)
 list(LENGTH project_headers header_count)
 message(STATUS "Standalone project header checks: ${header_count} public headers")
endif()
