{
  "name": "astrophoto-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4173",
    "build": "next build",
    "start": "node scripts/preview.mjs",
    "lint": "eslint",
    "sync:releases": "node scripts/sync-releases.mjs",
    "prebuild": "npm run sync:releases",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.tsx",
    "preview": "node scripts/preview.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "check:export": "node scripts/check-export.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "@tailwindcss/postcss": "^4"
  },
  "type": "module"
